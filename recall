#!/usr/bin/env python3
"""recall — search every Claude Code conversation Alex has ever had.

Replaces the `episodic-memory` plugin, removed 2026-08-14. That plugin indexed 48% of the
corpus, ranked the right answer 4th of 4 on a recorded test, and summarised conversations by
*resuming* them — which one day committed a from-scratch rebuild over five phases of finished
work. This does none of that. It reads files, indexes their text, and greps the index. No
model calls, no background jobs, no network.

Two roots, searched together, because neither is complete alone:

  ~/.claude/projects                    live transcripts. Claude Code prunes these at
                                        `cleanupPeriodDays` in ~/.claude/settings.json.
  ~/Code/system/conversation-archive    frozen snapshot from 2026-01-06 onward. Holds ~4,990
                                        conversations that exist NOWHERE else. Never deleted,
                                        never committed (gitignored), replicates via Syncthing.

🔒 The sealed Confidant archive (~/.local/share/confidant-archive) is NEVER indexed or searched.
Enforced twice: it is not in ROOTS, and any path containing "Confidant" is skipped at walk time.
That is the Iris seal. Do not "fix" it by adding the path.

The index at ~/.local/state/recall/index.sqlite is a REBUILDABLE CACHE. The transcripts are the
only source of truth. Delete the index any time; `recall` rebuilds it.

Usage:
  recall "vermouth trademark"        full-text search (FTS5: AND by default, "quoted phrase", OR, NOT)
  recall cartographer --since 2026-07
  recall "why did we" --project architect --limit 5
  recall --refresh                   index new/changed transcripts (automatic on first run)
  recall --rebuild                   throw the index away and start over
  recall --stats

Each hit prints a session id. To interrogate a conversation rather than read it:
  claude --resume <session-id>            works from any directory
  kit-consult.sh <session-id> "question"  reloads its full context and answers from it
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
import time
from pathlib import Path

HOME = Path.home()
ROOTS = [
    HOME / ".claude" / "projects",
    HOME / "Code" / "system" / "conversation-archive",
]
SEALED_MARKER = "Confidant"
DB = HOME / ".local" / "state" / "recall" / "index.sqlite"

NOISE = re.compile(
    r"<system-reminder>.*?</system-reminder>"
    r"|<command-name>.*?</command-name>"
    r"|<local-command-(?:stdout|caveat)>.*?</local-command-(?:stdout|caveat)>",
    re.DOTALL,
)


def connect() -> sqlite3.Connection:
    DB.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=NORMAL")
    db.executescript("""
        CREATE TABLE IF NOT EXISTS files (
            path TEXT PRIMARY KEY, mtime REAL, size INTEGER
        );
        CREATE VIRTUAL TABLE IF NOT EXISTS msgs USING fts5(
            text, project UNINDEXED, session UNINDEXED,
            day UNINDEXED, role UNINDEXED, path UNINDEXED,
            tokenize='porter unicode61'
        );
    """)
    return db


def pretty(key: str) -> str:
    return key.replace("-Users-alex-", "").replace("-", "/") or key


def walk() -> list[tuple[Path, str]]:
    out = []
    for root in ROOTS:
        if not root.exists():
            continue
        for p in root.rglob("*.jsonl"):
            if SEALED_MARKER in str(p):          # enforcement #2
                continue
            try:
                rel = p.relative_to(root)
                project = rel.parts[0] if rel.parts else "?"
            except ValueError:
                project = "?"
            out.append((p, project))
    return out


def messages(path: Path):
    try:
        fh = path.open(errors="ignore")
    except OSError:
        return
    with fh:
        for line in fh:
            if not line.strip():
                continue
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            if d.get("type") not in ("user", "assistant"):
                continue
            content = (d.get("message") or {}).get("content")
            if isinstance(content, str):
                text = content
            elif isinstance(content, list):
                text = "\n".join(
                    b.get("text", "") for b in content
                    if isinstance(b, dict) and b.get("type") == "text"
                )
            else:
                continue
            text = NOISE.sub("", text).strip()
            if text:
                yield (d.get("timestamp") or "")[:10], d.get("type"), text


def refresh(db: sqlite3.Connection, quiet: bool = False) -> int:
    known = {r[0]: (r[1], r[2]) for r in db.execute("SELECT path, mtime, size FROM files")}
    todo = []
    for p, project in walk():
        try:
            st = p.stat()
        except OSError:
            continue
        prev = known.get(str(p))
        if prev and abs(prev[0] - st.st_mtime) < 1 and prev[1] == st.st_size:
            continue
        todo.append((p, project, st))

    if not todo:
        return 0
    if not quiet:
        print(f"# indexing {len(todo)} new/changed transcripts…", file=sys.stderr)

    t0, n = time.time(), 0
    for i, (p, project, st) in enumerate(todo, 1):
        db.execute("DELETE FROM msgs WHERE path = ?", (str(p),))
        rows = [(text, project, p.stem, day, role, str(p))
                for day, role, text in messages(p)]
        if rows:
            db.executemany(
                "INSERT INTO msgs (text, project, session, day, role, path) "
                "VALUES (?,?,?,?,?,?)", rows)
            n += len(rows)
        db.execute("INSERT OR REPLACE INTO files VALUES (?,?,?)",
                   (str(p), st.st_mtime, st.st_size))
        if not quiet and i % 500 == 0:
            db.commit()
            print(f"#   {i}/{len(todo)}…", file=sys.stderr)
    db.commit()
    if not quiet:
        print(f"# indexed {n} messages in {time.time()-t0:.1f}s", file=sys.stderr)
    return n


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="recall", description="Search every Claude Code conversation.",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("query", nargs="*", help="FTS5 query (AND by default; \"phrase\"; OR; NOT)")
    ap.add_argument("--since"), ap.add_argument("--until")
    ap.add_argument("--project", help="substring of the project key")
    ap.add_argument("--limit", type=int, default=20)
    ap.add_argument("--recent", action="store_true",
                    help="order by date instead of relevance")
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--rebuild", action="store_true")
    ap.add_argument("--stats", action="store_true")
    a = ap.parse_args()

    if a.rebuild and DB.exists():
        DB.unlink()
        for suffix in ("-wal", "-shm"):
            q = Path(str(DB) + suffix)
            if q.exists():
                q.unlink()
        print("# index discarded (it is a cache; transcripts are untouched)", file=sys.stderr)

    db = connect()
    fresh = db.execute("SELECT COUNT(*) FROM files").fetchone()[0] == 0
    if fresh and not a.stats:
        print("# first run — building the index. The transcripts are the source of truth;\n"
              "# this index is a rebuildable cache.", file=sys.stderr)
    if a.refresh or a.rebuild or fresh:
        refresh(db)
        if a.refresh or a.rebuild:
            return 0

    if a.stats:
        n_msg = db.execute("SELECT COUNT(*) FROM msgs").fetchone()[0]
        n_file = db.execute("SELECT COUNT(*) FROM files").fetchone()[0]
        rng = db.execute("SELECT MIN(day), MAX(day) FROM msgs WHERE day != ''").fetchone()
        n_sess = db.execute("SELECT COUNT(DISTINCT session) FROM msgs").fetchone()[0]
        n_proj = db.execute("SELECT COUNT(DISTINCT project) FROM msgs").fetchone()[0]
        print(f"indexed : {n_msg:,} messages · {n_sess:,} sessions · {n_proj} projects "
              f"· {n_file:,} transcripts")
        print(f"span    : {rng[0]} → {rng[1]}")
        print(f"index   : {DB} ({DB.stat().st_size/1048576:.0f} MB, rebuildable cache)")
        for r in ROOTS:
            print(f"source  : {r}  {'✓' if r.exists() else '✗ MISSING'}")
        print(f"sealed  : ~/.local/share/confidant-archive — never indexed, by design")
        return 0

    if not a.query:
        ap.print_help()
        return 2

    q = " ".join(a.query)
    where, params = ["msgs MATCH ?"], [q]
    if a.since:
        where.append("day >= ?"); params.append(a.since)
    if a.until:
        where.append("day <= ?"); params.append(a.until)
    if a.project:
        where.append("project LIKE ?"); params.append(f"%{a.project}%")
    # Default to relevance, not recency. Recency put today's conversations *about* an old
    # thread above the old thread itself — which is the exact failure this tool replaced.
    order = "day DESC" if a.recent else "bm25(msgs)"
    # Over-fetch so dedupe below can still fill --limit.
    params.append(a.limit * 8)

    sql = (f"SELECT day, role, project, session, "
           f"snippet(msgs, 0, '\033[1;33m', '\033[0m', '…', 18) "
           f"FROM msgs WHERE {' AND '.join(where)} ORDER BY {order} LIMIT ?")
    try:
        rows = db.execute(sql, params).fetchall()
    except sqlite3.OperationalError as e:
        return sys.exit(f"recall: bad query {q!r} — {e}\n"
                        f"FTS5 syntax: words are AND'd, \"quote a phrase\", use OR / NOT.")

    total = db.execute(f"SELECT COUNT(*) FROM msgs WHERE {' AND '.join(where)}",
                       params[:-1]).fetchone()[0]

    # A conversation copied into the archive is indexed under both roots, so the same message
    # can surface twice. Dedupe on (session, snippet) at display time — the index stays a
    # faithful mirror of what is on disk, which is what makes it safely rebuildable.
    seen, shown = set(), 0
    for day, role, project, session, snip in rows:
        flat = " ".join(snip.split())
        key = (session, re.sub(r"\033\[[0-9;]*m", "", flat))
        if key in seen:
            continue
        seen.add(key)
        print(f"\n\033[1m{pretty(project)}\033[0m  {day}  {role}")
        print(f"  {session}")
        print(f"  {flat}")
        shown += 1
        if shown >= a.limit:
            break
    print(f"\n{shown} shown (deduped) of {total} raw match(es)"
          + ("  — raise --limit for more" if total > shown else "")
          + ("" if a.recent else "  · ranked by relevance; --recent for newest-first"),
          file=sys.stderr)
    if shown:
        print("\nInterrogate one:  claude --resume <session-id>"
              "   |   kit-consult.sh <session-id> \"question\"")
    return 0


if __name__ == "__main__":
    sys.exit(main())
